FROM node:18.14.2 AS base

WORKDIR /app

RUN npm install -g pnpm

COPY package.json ./

# Install pnpm
COPY . .

RUN git pull

# Install dependencies

RUN pnpm --filter dashboard install

FROM base AS dev

EXPOSE 3000 
EXPOSE 24678 

CMD [ "pnpm", "--filter", "dashboard", "dev" ]

FROM base AS prod

# Build the NestJS app
RUN pnpm build

# Expose the port the app runs on
EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]